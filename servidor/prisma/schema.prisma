// GymSystem - Modelo de datos
// Curso: Desarrollo de Aplicaciones Web
// Stack: Prisma ORM + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ROLES Y USUARIOS (quienes SÍ usan el sistema)
// ─────────────────────────────────────────────

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique // "ADMIN" | "EMPLEADO"
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  googleId  String?  @unique // id de Google (login con Google)
  password  String? // opcional: permite login local además de Google (útil para pruebas/demo)
  activo    Boolean  @default(true)
  rolId     Int
  rol       Rol      @relation(fields: [rolId], references: [id])
  pagos     Pago[]
  pasesDiarios PaseDiario[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// ENTRENADORES (solo dato administrativo, sin login)
// ─────────────────────────────────────────────

enum TipoEntrenador {
  PERSONALIZADO // entrenador personal: sesiones 1 a 1, agenda propia por cliente
  INSTRUCTOR    // instructor de piso del gimnasio: cubre un turno general
}

model Entrenador {
  id             Int              @id @default(autoincrement())
  nombre         String
  tipo           TipoEntrenador   @default(INSTRUCTOR)
  especialidad   String?
  telefono       String?
  disponibilidad String? // solo para PERSONALIZADO: texto libre, ej "Coordina por WhatsApp, tardes"
  activo         Boolean          @default(true)
  clientes       Cliente[]
  horarios       HorarioEntrenador[] // solo aplica en la práctica a INSTRUCTOR
  createdAt      DateTime         @default(now())

  @@map("entrenadores")
}

// Bloques de disponibilidad de cada entrenador (puede tener varios por semana)
model HorarioEntrenador {
  id           Int        @id @default(autoincrement())
  entrenadorId Int
  entrenador   Entrenador @relation(fields: [entrenadorId], references: [id])
  diaSemana    Int // 0=Domingo, 1=Lunes, ... 6=Sábado (igual que Date.getDay() en JS)
  horaInicio   String // formato "HH:mm", ej "08:00"
  horaFin      String // formato "HH:mm", ej "12:00"

  @@map("horarios_entrenador")
}

// ─────────────────────────────────────────────
// CLIENTES (solo dato administrativo, sin login)
// ─────────────────────────────────────────────

model Cliente {
  id             Int          @id @default(autoincrement())
  nombre         String
  dni            String       @unique
  telefono       String?
  correo         String?
  qrCode         String       @unique @default(uuid()) // identificador único para el pase QR
  entrenadorId   Int?
  entrenador     Entrenador?  @relation(fields: [entrenadorId], references: [id])
  membresias     Membresia[]
  asistencias    Asistencia[]
  fechaRegistro  DateTime     @default(now())

  @@map("clientes")
}

// ─────────────────────────────────────────────
// PLANES Y MEMBRESÍAS
// ─────────────────────────────────────────────

model Plan {
  id           Int         @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Float
  duracionDias Int // ej: 30 (mensual), 365 (anual)
  activo       Boolean     @default(true)
  membresias   Membresia[]

  @@map("planes")
}

enum EstadoMembresia {
  ACTIVA
  VENCIDA
  CANCELADA
}

model Membresia {
  id          Int             @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente         @relation(fields: [clienteId], references: [id])
  planId      Int
  plan        Plan            @relation(fields: [planId], references: [id])
  fechaInicio DateTime
  fechaFin    DateTime
  estado      EstadoMembresia @default(ACTIVA)
  pagos       Pago[]
  createdAt   DateTime        @default(now())

  @@map("membresias")
}

// ─────────────────────────────────────────────
// PAGOS (asociados a una membresía)
// ─────────────────────────────────────────────

enum MetodoPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
}

model Pago {
  id          Int        @id @default(autoincrement())
  membresiaId Int
  membresia   Membresia  @relation(fields: [membresiaId], references: [id])
  usuarioId   Int // quién registró el pago (Admin o Empleado)
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])
  monto       Float
  metodo      MetodoPago @default(EFECTIVO)
  fecha       DateTime   @default(now())

  @@map("pagos")
}

// ─────────────────────────────────────────────
// ASISTENCIAS (control de acceso vía QR)
// ─────────────────────────────────────────────

model Asistencia {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  fechaHora DateTime @default(now())

  @@map("asistencias")
}

// ─────────────────────────────────────────────
// PASE DIARIO (visitante sin membresía, registro rápido)
// ─────────────────────────────────────────────

model PaseDiario {
  id        Int      @id @default(autoincrement())
  nombre    String
  dni       String?
  monto     Float
  usuarioId Int // quién registró el ingreso (Admin o Empleado)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  fecha     DateTime @default(now())

  @@map("pases_diarios")
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN DEL GIMNASIO (horario de atención)
// Tabla de una sola fila (patrón singleton): siempre se usa/edita el id=1.
// ─────────────────────────────────────────────

model ConfiguracionGimnasio {
  id            Int      @id @default(1)
  horaApertura  String   @default("06:00") // formato "HH:mm"
  horaCierre    String   @default("22:00")
  diasAtencion  String   @default("Lunes a Domingo")
  updatedAt     DateTime @updatedAt

  @@map("configuracion_gimnasio")
}

// ─────────────────────────────────────────────
// MÁQUINAS / EQUIPAMIENTO DEL GIMNASIO
// ─────────────────────────────────────────────

enum TipoMaquina {
  CARDIO
  FUERZA
  PESO_LIBRE
  FUNCIONAL
  OTRO
}

enum EstadoMaquina {
  OPERATIVA
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Maquina {
  id        Int           @id @default(autoincrement())
  nombre    String // ej: "Caminadora", "Press de banca", "Rack de sentadillas"
  tipo      TipoMaquina
  cantidad  Int           @default(1)
  estado    EstadoMaquina @default(OPERATIVA)
  imagenUrl String? // opcional: link a una foto de referencia (no se suben archivos)
  createdAt DateTime      @default(now())

  @@map("maquinas")
}
