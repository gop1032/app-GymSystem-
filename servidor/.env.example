# PostgreSQL (Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/gymsystem?schema=public"

# JWT
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"

# Google OAuth 2.0 (Google Cloud Console -> Credenciales -> OAuth Client ID)
GOOGLE_CLIENT_ID="tu_google_client_id"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Sesión (requerida internamente por passport, no se usa para el login final)
SESSION_SECRET="otro_secreto_para_la_sesion_temporal"

# Frontend (a dónde redirigir después del login con Google)
CLIENT_URL="http://localhost:5173"

# Servidor
PORT=4000
